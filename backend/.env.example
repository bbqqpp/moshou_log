# 登录口令：访问网页时要输入的公会名。不配则任何人都登录不进来。
ALLOWED_GUILD_NAME=your_guild_name

# WCL V1 API
# WCL_V1_API_KEY: https://www.warcraftlogs.com/accounts/changeuser 页面底部的 Public key
WCL_V1_API_KEY=your_wcl_v1_key
# WCL_V1_CLIENT_NAME: 自行填写的应用名称，仅用于标记，不参与 V1 请求
WCL_V1_CLIENT_NAME=your_wcl_client_name

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=8000

# Optional tuning
MAX_WCL_EVENT_PAGES=200
TIMELINE_PREVIEW_LIMIT=1000
REQUEST_TIMEOUT=60
