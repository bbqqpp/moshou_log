# 登录口令：访问网页时要输入的公会名。不配则任何人都登录不进来。
ALLOWED_GUILD_NAME=your_guild_name

# WCL V2 API
# 在 https://www.warcraftlogs.com/api/clients/ 创建 client（必须选 confidential，
# 不要勾 Public Client，否则拿不到 secret）。Redirect URI 随便填一个本地地址即可，
# 例如 http://127.0.0.1:8001/callback —— 走 client credentials 时它不会被用到。
WCL_CLIENT_ID=your_wcl_client_id
WCL_CLIENT_SECRET=your_wcl_client_secret

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=8000

# Optional tuning
MAX_WCL_EVENT_PAGES=200
TIMELINE_PREVIEW_LIMIT=1000
REQUEST_TIMEOUT=60
