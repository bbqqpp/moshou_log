# WCL V1 API
WCL_V1_API_KEY=your_wcl_v1_key
WCL_V1_CLIENT_NAME=your_wcl_client_name

# DeepSeek
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_MAX_TOKENS=8000

# Optional tuning
MAX_WCL_EVENT_PAGES=200
MAX_DEEPSEEK_EVENT_CHARS=140000
TIMELINE_PREVIEW_LIMIT=1000
REQUEST_TIMEOUT=60
